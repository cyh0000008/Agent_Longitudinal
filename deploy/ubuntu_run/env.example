# Same Feishu bot credentials as the current Windows deployment.
# Do not commit real secrets. Private deploy scripts are generated from local .env.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# DeepSeek / LLM
LLM_API_KEY=
LLM_API_BASE_URL=https://api.kimi.com/coding/v1
LLM_MODEL=kimi-k2.7-code
LLM_TIMEOUT_SECONDS=300
LLM_DISABLE_THINKING=1
LLM_MAX_TOKENS=1600
BATCH_ROOT_CAUSE_DEEPSEEK_TIMEOUT_SECONDS=300

# Optional runtime path overrides on the Ubuntu machine.
# Leave them empty unless the deployment machine uses custom directories.
# Credentials above do not need to change when these paths change.
# Runtime defaults to a user-owned directory: $XDG_RUNTIME_DIR/blu-agent or
# ~/.cache/blu-agent/runtime. Do not set it to /tmp/blu_agent,
# /tmp/blu_agent_<user>, or any /tmp/blu_agent... path; those shared paths can
# be owned by another user and cause Permission denied.
BLU_AGENT_HOME=
BLU_AGENT_DATA=
BLU_AGENT_DATABASE=
BLU_AGENT_RUNTIME_DIR=
BLU_AGENT_RUNTIME=

# Feishu user authorization defaults.
# Run blu-agent-lark-auth on Ubuntu when Base/feedback commands report
# need_user_authorization/token_missing/requires scope. The command requests
# the base domain by default, so users do not need to hand-pick permissions.
# Do not configure BLU_LARK_AUTH_SCOPES here. base:record:read/base:field:write
# are Feishu app permission names, not lark-cli user-auth scopes.
BLU_LARK_AUTH_DOMAINS=
BLU_LARK_AUTH_SCOPES=
BLU_AGENT_AUTO_LARK_AUTH=0

# Feishu bot app permission checklist.
# Bot app scopes cannot be approved by lark-cli. Run blu-agent-bot-permissions
# to print the current Blu checklist, then enable/publish them in Feishu
# Developer Console for the same FEISHU_APP_ID.
BLU_BOT_PERMISSION_SCOPES=im_message_send,im_group_at_receive,im_resource_download,im_file_image_upload,contact_user_read,base_record_read,base_record_write,base_field_read,base_field_write,base_attachment_upload
BLU_AGENT_REFRESH_LARK_CLI=0

# Axle torque accuracy analysis.
# Optional: point to an ECM/CCB ARXML that contains
# PTEI_Transmission_General_Status_0CB_M.ITrnTrbAngVl.
# If empty, Blu first checks the Agent database directory.
AXLE_TORQUE_ARXML=
AXLE_TORQUE_OUTPUT_SCALE=1
AXLE_TORQUE_ABS_ERROR_THRESHOLD_NM=120
AXLE_TORQUE_MAE_ERROR_THRESHOLD_NM=90
AXLE_TORQUE_P95_ERROR_THRESHOLD_NM=240
AXLE_TORQUE_PASS_RATE_THRESHOLD=0.78
AXLE_TORQUE_PROGRESS_INTERVAL_SECONDS=2

# Feishu Base: batch root-cause analysis.
# The h5 path in Base must be an absolute path accessible on this Ubuntu machine.
BATCH_ROOT_CAUSE_BASE_TOKEN=
BATCH_ROOT_CAUSE_TABLE_ID=
BATCH_ROOT_CAUSE_FIELD_PROBLEM=Agent_问题描述
BATCH_ROOT_CAUSE_FIELD_H5_PATH=Agent_h5数据路径
BATCH_ROOT_CAUSE_FIELD_PROBLEM_TYPE=Agent_问题类型
BATCH_ROOT_CAUSE_FIELD_PROBLEM_DATE=Agent_问题日期
BATCH_ROOT_CAUSE_FIELD_PROBLEM_TIME=Agent_问题时间
BATCH_ROOT_CAUSE_FIELD_CAR_ID=Agent_车号
BATCH_ROOT_CAUSE_FIELD_CAR_MODEL=Agent_车型
BATCH_ROOT_CAUSE_FIELD_JIRA_LINK=JIRA链接
BATCH_ROOT_CAUSE_FIELD_JIRA_LINK_ID=
BATCH_ROOT_CAUSE_FIELD_CONCLUSION=Agent_分析结论
BATCH_ROOT_CAUSE_ATTACHMENT_FIELD=Agent_分析信号图示
BATCH_ROOT_CAUSE_FIELD_STATUS=Agent_问题状态
BATCH_ROOT_CAUSE_FIELD_SUMMARY=Agent_结论概要
BATCH_ROOT_CAUSE_H5_SEARCH_BASE_DIR=/path/to/authorized/ADAS_data/Parsed
BATCH_ROOT_CAUSE_BLF_SEARCH_BASE_DIR=/path/to/authorized/ADAS_data
BATCH_ROOT_CAUSE_ANALYSIS_MODE=deepseek_investigation
BATCH_ROOT_CAUSE_PROBLEM_TIME_WINDOW_SECONDS=10
BATCH_ROOT_CAUSE_FEISHU_RETRY_ATTEMPTS=3
BATCH_ROOT_CAUSE_LARK_CLI_AS=bot
BATCH_ROOT_CAUSE_LARK_CLI=lark-cli
BATCH_ROOT_CAUSE_SCAN_MAX_ROWS=5000
BATCH_ROOT_CAUSE_MAX_ROWS=0
BATCH_ROOT_CAUSE_ALLOW_USER_AUTH_FALLBACK=0

# Feishu Base: user feedback.
FEEDBACK_BASE_TOKEN=
FEEDBACK_TABLE_ID=
FEEDBACK_ATTACHMENT_FIELD=对话快照
FEEDBACK_LARK_CLI_AS=bot
FEEDBACK_LARK_CLI=lark-cli
FEEDBACK_RECORD_WRITER=sdk
FEEDBACK_CLEANUP_LOCAL_SNAPSHOT=1

# Python IO
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1

# Optional install-time network/proxy controls.
# The installer automatically clears local loopback proxies such as
# http://127.0.0.1:7897. This prevents pip/npx/lark-cli from hanging on
# desktop-only proxy settings copied to a server.
# Unless BLU_AGENT_KEEP_PROXY=1 is set, the installer also makes pip ignore
# user-level pip.conf by setting PIP_CONFIG_FILE=/dev/null and clears pip/npm
# proxy variables. This avoids stale desktop proxy settings being reused on
# Ubuntu.
# Force no proxy during installation:
# BLU_AGENT_NO_PROXY=1
# Force keeping a working proxy:
# BLU_AGENT_KEEP_PROXY=1
# Optional pip network knobs:
# PIP_TIMEOUT=60
# PIP_RETRIES=2
