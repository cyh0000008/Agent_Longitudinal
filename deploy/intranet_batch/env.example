# Copy this file to .env before running docker compose.
# Do not bake real keys into the image.

# Local or intranet OpenAI-compatible model endpoint.
# If the local model runs on the Docker host, use host.docker.internal.
# The model service must listen on a host-reachable address, not only 127.0.0.1.
# If it runs on another intranet machine, use http://<model-ip>:<port>/v1.
LLM_API_BASE_URL=http://host.docker.internal:8000/v1

# Leave empty when the local model API does not require auth.
# If the local model gateway requires auth, fill the token here.
LLM_API_KEY=
LLM_MODEL=local-model
LLM_TIMEOUT_SECONDS=300
BATCH_ROOT_CAUSE_DEEPSEEK_TIMEOUT_SECONDS=300
BATCH_ROOT_CAUSE_ANALYSIS_MODE=deepseek_investigation
BATCH_ROOT_CAUSE_PROBLEM_TIME_WINDOW_SECONDS=10

# Excel runner limits and path handling.
LOCAL_BATCH_MAX_ROWS=50
LOCAL_BATCH_DATA_ROOT=/data
LOCAL_BATCH_H5_SEARCH_BASE_DIR=/data
LOCAL_BATCH_FIELD_JIRA_LINK=JIRA链接

# Optional path map for Excel rows that still contain Windows or NAS paths.
# JSON example:
# LOCAL_BATCH_PATH_MAP={"E:\\ADAS_data":"/data/adas_data","\\\\nas\\adas":"/data/nas"}
LOCAL_BATCH_PATH_MAP=

# Optional database override for non-DeepSeek fallback mode.
BATCH_ROOT_CAUSE_DATABASE=

# UI binding inside the container. docker-compose maps host 8080 to this port.
LOCAL_BATCH_HOST=0.0.0.0
LOCAL_BATCH_PORT=8080
LOCAL_BATCH_UI_RUNTIME=/outputs
